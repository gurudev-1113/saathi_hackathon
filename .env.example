# ==============================================================================
# ReportSaathi Environment Configuration Template (NEVER commit real credentials)
# ==============================================================================

# Backend Port & Environment
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Google Gemini API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Tesseract OCR Path (Optional, for scanned image fallback)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Supabase Database & Auth (Optional, for cloud persistence)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_secret_or_service_role_key

# Frontend Environment Variables (in frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
